---
import navigation from '../../data/navigation.json';
import { getCollection } from 'astro:content';

const rawPath = Astro.url.pathname;
const currentPath = rawPath.endsWith('/') && rawPath !== '/' ? rawPath.slice(0, -1) : rawPath;
const blogPosts = await getCollection('blog');
const homelabPosts = await getCollection('homelab');
const hasPublishedPosts = blogPosts.some((post) => !post.data.draft);
const hasPublishedHomelabPosts = homelabPosts.some((post) => !post.data.draft);
const visibleNavigation = navigation.filter((item) => {
  if (item.href === '/blog') return hasPublishedPosts;
  if (item.href === '/homelab') return hasPublishedHomelabPosts;
  return true;
});
const isActive = (href: string) => currentPath === href
  || (href === '/projects' && currentPath.startsWith('/projects/'));
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="container">
    <ul class="nav-list">
      {visibleNavigation.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? (currentPath === item.href ? 'page' : 'location') : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    padding: var(--spacing-sm) 0;
    background-color: var(--color-bg-secondary);
  }

  .nav-list {
    display: flex;
    gap: var(--spacing-md);
    list-style: none;
    flex-wrap: wrap;
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-primary);
    background-color: var(--color-bg);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
