---
import type { CollectionEntry } from 'astro:content';
import { projectRoleLabels } from '../../utils/projects';
import InlineCode from './InlineCode.astro';
import ProjectLogo from './ProjectLogo.astro';
import ProjectStatus from './ProjectStatus.astro';
import ProjectTechnologies from './ProjectTechnologies.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const titleId = `project-${project.id}`;
---

<article class="project-card">
  <a class="project-card-link" href={`/projects/${project.id}`} aria-labelledby={titleId}>
    <div class="project-card-heading">
      <div class="project-card-header">
        {project.data.logoImage && (
          <ProjectLogo class="project-card-logo" src={project.data.logoImage} height={48} />
        )}
        <h2 class="project-card-title" id={titleId}>{project.data.title}</h2>
      </div>
      <p class="project-card-metadata">
        <span class="project-card-role">{projectRoleLabels[project.data.role]}</span>
        <span class="project-card-status">
          <span class="project-card-separator" aria-hidden="true">&middot;</span>
          <ProjectStatus status={project.data.status} variant="inline" />
        </span>
      </p>
    </div>
    <p class="project-card-description"><InlineCode text={project.data.description} /></p>
    <ProjectTechnologies technologies={project.data.technologyStack} />
    <div class="project-card-footer">
      <span class="project-card-more">Read about this project <span aria-hidden="true">&rarr;</span></span>
    </div>
  </a>
</article>

<style>
  .project-card {
    --project-card-logo-height: 3rem;
    height: 100%;
    min-width: 0;
  }

  .project-card-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-md);
    height: 100%;
    padding: var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    overflow-wrap: anywhere;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .project-card-link:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .project-card-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  .project-card-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .project-card-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    width: 100%;
    min-height: var(--project-card-logo-height);
  }

  .project-card-logo {
    color-scheme: var(--image-color-scheme);
    height: var(--project-card-logo-height);
    width: auto;
    max-width: 8rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .project-card-title {
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    min-width: 0;
  }

  .project-card-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-xs) var(--spacing-sm);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .project-card-role {
    color: var(--color-text);
    font-weight: 500;
  }

  .project-card-status {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-sm);
  }

  .project-card-separator {
    flex-shrink: 0;
  }

  .project-card-description {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    width: 100%;
    margin-top: auto;
    padding-top: var(--spacing-sm);
  }

  .project-card-more {
    color: var(--color-primary);
    font-weight: 500;
  }

  .project-card-link:hover .project-card-more {
    text-decoration: underline;
  }

  @media (max-width: 36rem) {
    .project-card-link {
      padding: var(--spacing-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-link {
      transition: none;
    }
  }
</style>
