---
import { Image } from 'astro:assets';
import type { LinkedRecommendation } from '../../utils/recommendations';
import { formatRecommendationDate } from '../../schemas/recommendations';
import '../../styles/entry-target.css';
import '../../styles/related-entry.css';

interface Props {
  recommendation: LinkedRecommendation['data'];
  id: string;
}

const { recommendation, id } = Astro.props;

const allPeople = import.meta.glob<{ default: ImageMetadata }>('../../assets/people/*.{jpg,svg}', { eager: true });
const allLogos  = import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/companies/*', { eager: true });

const photoKey = `../../assets/people/${recommendation.author.toLowerCase().replace(/\s+/g, '-')}`;
const photoSrc = allPeople[`${photoKey}.jpg`]?.default ?? allPeople[`${photoKey}.svg`]?.default;
---

<article class="recommendation-card" id={id} tabindex="-1" aria-label={`Recommendation from ${recommendation.author}`}>
  <blockquote class="recommendation-text">
    <p>{recommendation.text}</p>
  </blockquote>
  <footer class="recommendation-footer">
    <div class="recommendation-author-block">
      {photoSrc && (
        <Image class="recommendation-photo related-entry-image" src={photoSrc} alt="" height={48} width={48} />
      )}
      <div class="recommendation-author">
        <a href={recommendation.linkedIn} class="recommendation-author-link"
           target="_blank" rel="noopener noreferrer">
          <strong>{recommendation.author}</strong>
        </a>
        <time class="recommendation-date">{formatRecommendationDate(recommendation.date)}</time>
      </div>
    </div>
    <div class="recommendation-roles">
      {recommendation.roles.map((r) => {
        const logoKey = `../../assets/logos/companies/${r.logo}`;
        const roleLogo = allLogos[logoKey]?.default;
        // Give each destination its own whole-block link; unlinked roles remain text.
        const destinations = r.experiences.length ? r.experiences : [undefined];
        return destinations.map((experience) => {
          const Entry = experience ? 'a' : 'div';
          return (
            <Entry class:list={['recommendation-role-entry', 'related-entry', { 'recommendation-experience-link': experience }]}
                   href={experience ? `/experience#${experience.id}` : undefined}>
              {roleLogo && (
                <Image class="recommendation-role-logo related-entry-image" src={roleLogo} alt="" height={48} />
              )}
              <div class="recommendation-role-text related-entry-content">
                <span class="recommendation-role related-entry-title"><span class="recommendation-role-phrase">{r.role},</span>{' '}<span class="recommendation-role-phrase">{r.company}</span></span>
                {r.experiences.length > 1 && experience && (
                  <span class="recommendation-related-role related-entry-meta">{experience.data.role}</span>
                )}
                <span class="recommendation-relationship related-entry-meta">{r.relationship}</span>
                {experience && (
                  <span class="recommendation-engagement-link related-entry-action">See engagement <span aria-hidden="true">→</span></span>
                )}
              </div>
            </Entry>
          );
        });
      })}
    </div>
  </footer>
</article>

<style>
  .recommendation-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-xl);
    background-color: var(--color-surface);
    scroll-margin-top: var(--spacing-lg);
  }

  .recommendation-card:focus-visible:not(:target) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .recommendation-card + .recommendation-card {
    margin-top: var(--spacing-xl);
  }

  .recommendation-text {
    margin: 0 0 var(--spacing-lg) 0;
    padding: 0;
    border: none;
  }

  .recommendation-text p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 0;
  }

  .recommendation-text p::before,
  .recommendation-text p::after {
    font-size: 1.5em;
    /* Keep the larger decorative glyphs from expanding the text's line boxes. */
    line-height: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .recommendation-text p::before {
    content: '\201C';
    margin-right: 0.1em;
  }

  .recommendation-text p::after {
    content: '\201D';
    margin-left: 0.1em;
  }

  .recommendation-footer {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--spacing-sm);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  /* Left: photo + author info */
  .recommendation-author-block {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
  }

  .recommendation-photo {
    width: 3rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .recommendation-author {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .recommendation-author-link {
    color: inherit;
    text-decoration: none;
  }

  .recommendation-author-link:hover {
    text-decoration: underline;
  }

  .recommendation-author-link strong {
    font-size: 1rem;
    color: var(--color-text);
  }

  .recommendation-date {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* Reserve two equal role columns, even when the middle one is empty. */
  .recommendation-roles {
    display: grid;
    grid-column: 2 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
    align-items: start;
  }

  .recommendation-role-entry:only-child {
    grid-column: 2;
  }

  .recommendation-role {
    max-width: 100%;
  }

  .recommendation-role-phrase {
    /* Prefer wrapping after the comma, but let oversized phrases wrap within the card. */
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
  }

  .recommendation-role-logo {
    width: auto;
    max-width: 5rem;
    object-fit: contain;
    object-position: top;
  }

  @media (max-width: 767px) {
    .recommendation-footer {
      grid-template-columns: minmax(0, 1fr);
    }

    .recommendation-roles {
      grid-column: 1;
      grid-template-columns: minmax(0, 1fr);
    }

    .recommendation-role-entry:only-child {
      grid-column: 1;
    }
  }
</style>
