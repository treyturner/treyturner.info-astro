---
import type { ProjectFrontmatter } from '../../schemas/projects';
import { projectStatusLabels } from '../../utils/projects';

interface Props {
  status: ProjectFrontmatter['status'];
  variant?: 'badge' | 'inline';
}

const { status, variant = 'badge' } = Astro.props;
---

<span class:list={['project-status', `project-status-${variant}`]}>
  {variant === 'inline' && <span class="project-status-label">Status: </span>}
  {projectStatusLabels[status]}
</span>

<style>
  .project-status {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .project-status-label {
    font-weight: 400;
  }

  .project-status-badge {
    display: inline-block;
    width: fit-content;
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
  }
</style>
