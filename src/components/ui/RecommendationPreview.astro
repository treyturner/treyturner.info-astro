---
import { Image } from 'astro:assets';
import type { ExperienceRecommendation } from '../../utils/recommendations';
import '../../styles/related-entry.css';

interface Props {
  recommendation: ExperienceRecommendation;
}

const { recommendation } = Astro.props;
const allPeople = import.meta.glob<{ default: ImageMetadata }>('../../assets/people/*.{jpg,svg}', { eager: true });
const photoKey = `../../assets/people/${recommendation.author.toLowerCase().replace(/\s+/g, '-')}`;
const photoSrc = allPeople[`${photoKey}.jpg`]?.default ?? allPeople[`${photoKey}.svg`]?.default;
---

<a class="recommendation-preview related-entry" href={`/recommendations#${recommendation.id}`}
   aria-label={`Read recommendation from ${recommendation.author}`}>
  {photoSrc && <Image class="preview-photo related-entry-image" src={photoSrc} alt="" width={48} height={48} />}
  <span class="preview-details related-entry-content">
    <strong class="preview-author related-entry-title">{recommendation.author}</strong>
    {recommendation.roles.map((role) => (
      <span class="preview-role related-entry-meta">{role.role} · {role.relationship}</span>
    ))}
    <span class="preview-link related-entry-action">Read recommendation <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .recommendation-preview {
    height: 100%;
  }

  .preview-photo {
    width: 3rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }
</style>
