---
import { Image } from 'astro:assets';
import { formatDateRange } from '../../schemas/experience';
import type { Experience } from '../../schemas/experience';
import type { ExperienceRecommendation } from '../../utils/recommendations';
import RecommendationPreview from './RecommendationPreview.astro';
import '../../styles/entry-target.css';

interface Props {
  experience: Experience;
  id: string;
  recommendations: ExperienceRecommendation[];
}

const { experience, id, recommendations } = Astro.props;
const dateRange = formatDateRange(experience.startDate, experience.endDate);
const isCurrent = !experience.endDate;

const allLogos = import.meta.glob<{ default: ImageMetadata }>('../../assets/logos/companies/*', { eager: true });
const logoKey  = `../../assets/logos/companies/${experience.logo}`;
const logoSrc  = allLogos[logoKey]?.default;
---

<article class="experience-card" id={id} tabindex="-1" aria-labelledby={`${id}-role`}>
  <div class="experience-header">
    <div>
      <h2 class="experience-role" id={`${id}-role`}>{experience.role}</h2>
      <p class="experience-company">{experience.company}</p>
    </div>
    <div class="experience-meta">
      {logoSrc && (
        <Image class="experience-logo" src={logoSrc} alt={experience.company} height={36} />
      )}
      <time class="experience-dates">{dateRange}</time>
      {isCurrent && <span class="experience-badge">Current</span>}
    </div>
  </div>
  <p class="experience-description">{experience.description}</p>
  <ul class="experience-highlights">
    {experience.highlights.map((highlight) => (
      <li>{highlight}</li>
    ))}
  </ul>
  {recommendations.length > 0 && (
    <section class="experience-recommendations" aria-labelledby={`${id}-recommendations`}>
      <h3 id={`${id}-recommendations`}>Recommendations</h3>
      <ul class="experience-recommendation-list">
        {recommendations.map((recommendation) => (
          <li><RecommendationPreview recommendation={recommendation} /></li>
        ))}
      </ul>
    </section>
  )}
</article>

<style>
  .experience-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-xl);
    background-color: var(--color-surface);
    scroll-margin-top: var(--spacing-lg);
  }

  .experience-card:focus-visible:not(:target) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .experience-card + .experience-card {
    margin-top: var(--spacing-xl);
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .experience-role {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-xs);
  }

  .experience-company {
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 0;
  }

  .experience-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;
  }

  .experience-logo {
    height: 2.25rem;
    width: auto;
    max-width: 6rem;
    object-fit: contain;
  }

  .experience-dates {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .experience-badge {
    background-color: var(--color-primary);
    color: var(--color-bg);
    font-size: 0.75rem;
    font-weight: 600;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .experience-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .experience-highlights {
    list-style: none;
    padding: 0;
  }

  .experience-highlights li {
    position: relative;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .experience-highlights li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .experience-recommendations {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .experience-recommendations h3 {
    font-size: 0.875rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-secondary);
  }

  .experience-recommendation-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
    list-style: none;
    padding: 0;
  }

  @media (max-width: 600px) {
    .experience-recommendation-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
