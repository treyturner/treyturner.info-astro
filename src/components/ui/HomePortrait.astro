---
import { Image } from 'astro:assets';
import portrait from '../../assets/people/trey-turner.jpg';
---

<div class="home-portrait">
  <Image
    src={portrait}
    alt="Trey Turner"
    width={160}
    height={160}
    widths={[128, 160, 256, 320]}
    sizes="(max-width: 640px) 128px, (max-width: 800px) 20vw, 160px"
    format="webp"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</div>

<style>
  .home-portrait {
    position: relative;
    isolation: isolate;
    width: clamp(8rem, 20vw, 10rem);
    max-width: calc(100% - 2rem);
    aspect-ratio: 1;
    margin: 0 auto var(--spacing-xl);
  }

  .home-portrait::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 7% auto auto -7%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* Keep the old site's yellow crescent in both themes. */
    background: linear-gradient(135deg, rgb(238 238 34 / 0.4), rgb(238 238 34 / 0.01));
    pointer-events: none;
  }

  .home-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 3px solid var(--color-bg);
    border-radius: 50%;
  }
</style>
