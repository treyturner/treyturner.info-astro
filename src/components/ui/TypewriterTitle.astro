---
import { defaultTypewriterTimings, type TypewriterTimings } from '../../utils/typewriter';

interface Props {
  titles: string[];
  fallback: string;
  timings?: Partial<TypewriterTimings>;
}

const { titles, fallback, timings = {} } = Astro.props;
const settings = { ...defaultTypewriterTimings, ...timings };
---

<typewriter-title data-titles={JSON.stringify(titles)} data-timings={JSON.stringify(settings)}>
  <p class="visually-hidden">{fallback}</p>
  <p class="typewriter-words" aria-hidden="true">
    <span data-fallback>{fallback}</span>
    <!-- Keep space for every complete title, including mobile wrapping and the static fallback. -->
    {[fallback, ...titles].map((title) => <span class="typewriter-measure">{title}</span>)}
    <span data-animated hidden><span data-text></span></span>
  </p>
</typewriter-title>

<script>
  import { createTypewriter } from '../../utils/typewriter';

  class TypewriterTitle extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;
      const fallback = this.querySelector<HTMLElement>('[data-fallback]')!;
      const animated = this.querySelector<HTMLElement>('[data-animated]')!;
      const text = this.querySelector<HTMLElement>('[data-text]')!;
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      text.textContent = '';
      const player = createTypewriter(
        JSON.parse(this.dataset.titles!),
        (value) => { text.textContent = value; },
        JSON.parse(this.dataset.timings!),
      );
      const refresh = () => {
        const enabled = !motion.matches;
        fallback.hidden = enabled;
        animated.hidden = !enabled;
        const running = enabled && !document.hidden;
        this.toggleAttribute('data-running', running);
        if (running) player.resume();
        else player.pause();
      };
      motion.addEventListener('change', refresh);
      document.addEventListener('visibilitychange', refresh);
      this.cleanup = () => {
        player.destroy();
        motion.removeEventListener('change', refresh);
        document.removeEventListener('visibilitychange', refresh);
      };
      refresh();
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('typewriter-title')) customElements.define('typewriter-title', TypewriterTitle);
</script>

<style>
  typewriter-title {
    --title-accent: #806000;
    display: block;
    max-width: 100%;
    margin-bottom: var(--spacing-lg);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--title-accent);
  }

  :global([data-theme="dark"]) typewriter-title { --title-accent: #eeee22; }

  .typewriter-words {
    display: grid;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    margin: 0 auto;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .typewriter-words > span { grid-area: 1 / 1; }
  .typewriter-measure { visibility: hidden; pointer-events: none; user-select: none; }
</style>
