---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypewriterTitle from '../components/ui/TypewriterTitle.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import siteData from '../data/site.json';

const socialLinks = [
  { name: 'github', label: 'GitHub', href: siteData.social.github },
  { name: 'linkedin', label: 'LinkedIn', href: siteData.social.linkedin },
  { name: 'patreon', label: 'Patreon', href: siteData.social.patreon },
  { name: 'stackoverflow', label: 'Stack Overflow', href: siteData.social.stackoverflow },
  { name: 'spotify', label: 'Spotify', href: siteData.social.spotify },
] as const;
---

<BaseLayout>
  <section class="vcard">
    <h1 class="vcard-name">{siteData.name}</h1>
    <TypewriterTitle titles={siteData.rotatingTitles} fallback={siteData.title} timings={siteData.titleAnimation} />
    <p class="vcard-tagline">{siteData.tagline}</p>
    <div class="vcard-social">
      {socialLinks.map(({ name, label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" class="social-link" title={`${label} (opens in a new tab)`}>
          <SocialIcon name={name} />
          <span class="visually-hidden">{label}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .vcard {
    max-width: var(--content-width);
    margin-inline: auto;
    text-align: center;
    padding: var(--spacing-3xl) 0;
  }

  .vcard-name {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .vcard-tagline {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin-inline: auto;
    margin-bottom: var(--spacing-2xl);
    line-height: 1.7;
  }

  .vcard-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .social-link :global(svg) {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  /* Tighten the optical gap between these narrower marks without moving their hit targets. */
  .social-link :global(.patreon-icon) { transform: translateX(0.0625rem); }
  .social-link :global(.stackoverflow-icon) { transform: translateX(-0.0625rem); }

  .social-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Keep all five icons together on phones while retaining 48px touch targets. */
  @media (max-width: 30rem) {
    .vcard-social { gap: var(--spacing-sm); }
    .social-link { width: 3rem; height: 3rem; }
  }
</style>
