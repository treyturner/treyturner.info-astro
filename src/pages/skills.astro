---
import BaseLayout from '../layouts/BaseLayout.astro';
import skillsData from '../data/skills.json';
---

<BaseLayout title="Skills" description="Technical skills and areas of expertise spanning test automation, CI/CD, cloud infrastructure, and quality engineering.">
  <section class="skills-page">
    <h1>Skills</h1>
    <p class="skills-intro">
      Core competencies built over two decades of quality engineering, test automation, and infrastructure work.
    </p>
    <div class="skills-grid">
      {skillsData.categories.map((category, index) => (
        <section class="skill-category" aria-labelledby={`skill-group-${index}`}>
          <h2 id={`skill-group-${index}`}>{category.name}</h2>
          <ol class="skill-list" role="list" aria-labelledby={`skill-group-${index}`}>
            {category.skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .skills-page {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .skills-page h1 {
    margin-bottom: var(--spacing-md);
  }

  .skills-intro {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
  }

  .skills-grid {
    display: grid;
    /* Collapse columns instead of overflowing on small screens or enlarged text. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--spacing-xl);
    align-items: start;
  }

  .skill-category {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--spacing-md);
    overflow-wrap: anywhere;
  }

  .skill-category h2 {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
    color: var(--color-primary);
  }

  .skill-list {
    list-style: none;
    display: grid;
    gap: var(--spacing-xs);
    margin: 0;
    padding: 0;
  }

  .skill-item {
    font-size: 1rem;
    color: var(--color-text);
  }
</style>
