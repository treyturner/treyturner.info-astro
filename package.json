{
  "name": "treyturner.info-astro",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^5.0.1",
    "allure-commandline": "^2.46.1",
    "allure-vitest": "^3.12.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "vitest": "^5.0.0"
  }
